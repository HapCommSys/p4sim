# IPv4 is forwarded by destination address. The destination MAC becomes the
# next hop's, the source MAC the old destination MAC; nothing else changes.
# Two packets to the same port leave in the order they came.

# port 0 -> 10.0.1.1, twice
packet 0 0000000000fe 000000000010 0800  45000020 00010000 401165cb 0a000001 0a000101  04d2162e 000c0000  00000001
expect 1 000000000011 0000000000fe 0800  45000020 00010000 401165cb 0a000001 0a000101  04d2162e 000c0000  00000001
packet 0 0000000000fe 000000000010 0800  45000020 00020000 401165ca 0a000001 0a000101  04d2162e 000c0000  00000002
expect 1 000000000011 0000000000fe 0800  45000020 00020000 401165ca 0a000001 0a000101  04d2162e 000c0000  00000002
# port 0 -> 10.0.2.1
packet 0 0000000000fe 000000000010 0800  45000020 00030000 401164c9 0a000001 0a000201  04d2162e 000c0000  00000003
expect 2 000000000012 0000000000fe 0800  45000020 00030000 401164c9 0a000001 0a000201  04d2162e 000c0000  00000003
# port 2 -> 10.0.0.1
packet 2 0000000000fe 000000000012 0800  45000020 00040000 401164c8 0a000201 0a000001  04d2162e 000c0000  00000004
expect 0 000000000010 0000000000fe 0800  45000020 00040000 401164c8 0a000201 0a000001  04d2162e 000c0000  00000004
